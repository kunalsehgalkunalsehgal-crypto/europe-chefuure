# Copy these values into Render Dashboard > Environment.
# Do NOT upload this file with real passwords.

APP_NAME="Europe Chauffeur"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://YOUR-SERVICE-NAME.onrender.com

LOG_CHANNEL=stderr

# This project does not need database-backed sessions/cache/queue
# for the current email-only booking flow.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Europe Chauffeur"
